{
  "name": "analysetool-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Static landing page for AnalyseTool, the free Revit plugin. Vue 3 + TypeScript 7 + Vite; `npm run build` emits a self-contained site into dist/.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
